# Supabase project credentials
# Get these from https://app.supabase.com — create a new project, then find them under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Site URL — used for email confirmation redirects
# IMPORTANT: This must also be set in Supabase Dashboard > Authentication > Settings > Site URL
NEXT_PUBLIC_SITE_URL=https://your-vercel-app-url.vercel.app
